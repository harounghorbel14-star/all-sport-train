# Database (SQLite by default; switch provider in prisma/schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

# Session secret used to sign nothing secret-bearing but to pepper session token hashes (min 32 chars)
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Comma-separated emails that receive the admin role on registration (exercise management)
ADMIN_EMAILS=""

# Optional AI provider (Anthropic). Without it the coach, meal estimator and form check use rule-based fallbacks.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# Optional USDA FoodData Central key for extended food search. Without it the local food database is used.
FDC_API_KEY=""

# Where private uploads (form-check media, progress photos) are stored. Never inside /public.
UPLOAD_DIR="./storage/uploads"

# Subscription tier enforcement. "false" keeps every feature available (no payment provider configured).
ENFORCE_TIERS="false"

# Public base URL of the app — used for the Google OAuth callback and links in emails.
# Must match exactly what you register in Google Cloud (scheme + host + port). Use https in production.
APP_BASE_URL="http://localhost:3000"

# Google Sign-In (OAuth 2.0 / OpenID Connect). Server-side only — never expose the secret to the browser.
# Without these, the Google button is hidden in production (and shows a configuration notice in development).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CALLBACK_URL=""

# Password-reset email via Resend (https://resend.com). Without it: development logs the reset link to the
# server console only; production sends nothing (and logs an error).
RESEND_API_KEY=""
MAIL_FROM="APEX FIT <no-reply@your-domain.com>"
