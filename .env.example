# Database (SQLite by default; switch provider in prisma/schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

# Session secret used to sign nothing secret-bearing but to pepper session token hashes (min 32 chars)
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Comma-separated emails that receive the admin role on registration (exercise management)
ADMIN_EMAILS=""

# Optional AI provider (Anthropic). Without it the coach, meal estimator and form check use rule-based fallbacks.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# Optional USDA FoodData Central key for extended food search. Without it the local food database is used.
FDC_API_KEY=""

# Where private uploads (form-check media, progress photos) are stored. Never inside /public.
UPLOAD_DIR="./storage/uploads"

# Subscription tier enforcement. "false" keeps every feature available (no payment provider configured).
ENFORCE_TIERS="false"
